<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Baseera</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.8</Version>
    <InformationalVersion>0.4.8-preview</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Baseera.Core/Baseera.Core.csproj" />
    <Content Include="Locales/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Fonts/*OFL.txt" />
    <Resource Include="Assets/Fonts/*.CompositeFont" />
  </ItemGroup>
</Project>
